# URL de base de l’API backend.
# Laisser vide en développement pour utiliser le proxy Vite /api.
# Exemple production : https://api.example.com/api
VITE_API_URL=

# URL publique du gateway pour les commandes cURL, Postman et intégrations externes.
# Exemple : https://api.example.com/api
# En développement local, laisser vide si aucun gateway public n’est disponible.
VITE_PUBLIC_API_URL=

# URL du AI Core pour les contrôles directs depuis l’interface.
# Exemple production : https://ai.example.com
VITE_AI_CORE_URL=http://localhost:8001

# Paramètres legacy conservés pour la compatibilité éventuelle avec l’ancien SDK.
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=
